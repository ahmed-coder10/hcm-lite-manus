# ---- Server ----------------------------------------------------------------
PORT=5000
NODE_ENV=development

# SQLite file (no database server needed). Use an absolute path on a mounted
# disk when deploying so data survives restarts.
DB_FILE=./data/hcm.db

# JWT signing secret — change this in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Minutes east of UTC used for every attendance / payroll calculation.
APP_UTC_OFFSET_MINUTES=300

# First-run admin (only used if you set up the company from the env instead of
# the setup wizard). The wizard always wins if a company already exists.
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Admin

# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- AI (optional but scored) ---------------------------------------------
# Any OpenAI-compatible chat-completions endpoint that supports tool calling.
# Groq:      AI_BASE_URL=https://api.groq.com/openai/v1   AI_MODEL=llama-3.3-70b-versatile
# OpenRouter AI_BASE_URL=https://openrouter.ai/api/v1     AI_MODEL=openai/gpt-4o-mini
# OpenAI:    AI_BASE_URL=https://api.openai.com/v1        AI_MODEL=gpt-4o-mini
# Gemini:    AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.0-flash
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000
AI_MAX_TOOL_ROUNDS=4
AI_ENABLED=true
